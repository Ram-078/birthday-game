  - speaker: {fileID: 11400000, guid: 6cb4028ff2cc77e478bbb362e91e66cd, type: 2}
    text: Not very excited about it...
    autoProgress: 1
    autoProgressDuration: 1.25
  - speaker: {fileID: 11400000, guid: 757e9fef7d0d72640b1ce91c5a603167, type: 2}
    text: You did what you had to do
    autoProgress: 1
    autoProgressDuration: 1.25
  - speaker: {fileID: 11400000, guid: 6cb4028ff2cc77e478bbb362e91e66cd, type: 2}
    text: Where am I now?
    autoProgress: 1
    autoProgressDuration: 1.25
  - speaker: {fileID: 11400000, guid: 757e9fef7d0d72640b1ce91c5a603167, type: 2}
    text: 'I know you''re hiding something...

      I can see the memory of the
      poem you took.'
    autoProgress: 1
    autoProgressDuration: 1.25
  - speaker: {fileID: 11400000, guid: 757e9fef7d0d72640b1ce91c5a603167, type: 2}
    text: $TOP DO!NG TH@T!!!!!

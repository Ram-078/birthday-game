  npcCharacter: {fileID: 11400000, guid: 757e9fef7d0d72640b1ce91c5a603167, type: 2}
  lines:
  - speaker: {fileID: 11400000, guid: 6cb4028ff2cc77e478bbb362e91e66cd, type: 2}
    text: I had to beat the baby this time :(
    autoProgress: 1
    autoProgressDuration: 1.25
  - speaker: {fileID: 11400000, guid: 757e9fef7d0d72640b1ce91c5a603167, type: 2}
    text: Do not fret...
    autoProgress: 1
    autoProgressDuration: 1.25
  - speaker: {fileID: 11400000, guid: 757e9fef7d0d72640b1ce91c5a603167, type: 2}
    text: It was a demon, so are all the other ones in these lands.
    autoProgress: 1
    autoProgressDuration: 1.25
  - speaker: {fileID: 11400000, guid: 6cb4028ff2cc77e478bbb362e91e66cd, type: 2}
    text: And I found the poem he gave me!!!
    autoProgress: 1
    autoProgressDuration: 1.25
  - speaker: {fileID: 11400000, guid: 757e9fef7d0d72640b1ce91c5a603167, type: 2}
    text: NO!!!!
    autoProgress: 1
    autoProgressDuration: 1.25
  - speaker: {fileID: 11400000, guid: 757e9fef7d0d72640b1ce91c5a603167, type: 2}
    text: I told you not to focus on those.
    autoProgress: 1
    autoProgressDuration: 1.25
  - speaker: {fileID: 11400000, guid: 757e9fef7d0d72640b1ce91c5a603167, type: 2}
    text: Anyways, this was the first time you came to his house...
    autoProgress: 0
    autoProgressDuration: 1.25
  typingSpeed: 0.075

  lines:
  - speaker: {fileID: 11400000, guid: 6cb4028ff2cc77e478bbb362e91e66cd, type: 2}
    text: Shishi...
    autoProgress: 1
    autoProgressDuration: 1.25
  - speaker: {fileID: 11400000, guid: 6cb4028ff2cc77e478bbb362e91e66cd, type: 2}
    text: Finally...
    autoProgress: 1
    autoProgressDuration: 1.25
  - speaker: {fileID: 11400000, guid: cbeb5c822b9244742889380c5ef8bda7, type: 2}
    text: 'I missed you so much

      I love you'
    autoProgress: 1
    autoProgressDuration: 1.25
  - speaker: {fileID: 11400000, guid: 6cb4028ff2cc77e478bbb362e91e66cd, type: 2}
    text: I love you
    autoProgress: 1
    autoProgressDuration: 1.25
  - speaker: {fileID: 11400000, guid: 6cb4028ff2cc77e478bbb362e91e66cd, type: 2}
    text: Where did Kunekt go?
    autoProgress: 1
    autoProgressDuration: 1.25
  - speaker: {fileID: 11400000, guid: cbeb5c822b9244742889380c5ef8bda7, type: 2}
    text: She made me forget everything about you and everyone else.
    autoProgress: 1
    autoProgressDuration: 1.25
  - speaker: {fileID: 11400000, guid: cbeb5c822b9244742889380c5ef8bda7, type: 2}
    text: You reminded me of everything...
    autoProgress: 1
    autoProgressDuration: 1.25
  - speaker: {fileID: 11400000, guid: cbeb5c822b9244742889380c5ef8bda7, type: 2}
    text: EVERYTHING.
    autoProgress: 1
    autoProgressDuration: 1.25
  - speaker: {fileID: 11400000, guid: cbeb5c822b9244742889380c5ef8bda7, type: 2}
    text: She is gone now...
    autoProgress: 1
    autoProgressDuration: 1.25
  - speaker: {fileID: 11400000, guid: cbeb5c822b9244742889380c5ef8bda7, type: 2}
    text: It's just us.
    autoProgress: 1
    autoProgressDuration: 1.25
  - speaker: {fileID: 11400000, guid: cbeb5c822b9244742889380c5ef8bda7, type: 2}
    text: And
    autoProgress: 1
    autoProgressDuration: 1.25
  - speaker: {fileID: 11400000, guid: cbeb5c822b9244742889380c5ef8bda7, type: 2}
    text: Happy Birthday Babita!!!
    autoProgress: 1
    autoProgressDuration: 1.25
  - speaker: {fileID: 11400000, guid: cbeb5c822b9244742889380c5ef8bda7, type: 2}
    text: I love you so much.
    autoProgress: 0
    autoProgressDuration: 1.25

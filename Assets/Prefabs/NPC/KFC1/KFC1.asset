  lines:
  - speaker: {fileID: 11400000, guid: 6cb4028ff2cc77e478bbb362e91e66cd, type: 2}
    text: THUSHARA!!!!???? TAJAYYY??? SUGARRR???
    autoProgress: 1
    autoProgressDuration: 1.25
  - speaker: {fileID: 11400000, guid: 6cb4028ff2cc77e478bbb362e91e66cd, type: 2}
    text: Oh right! They can't see me.
    autoProgress: 1
    autoProgressDuration: 1.25
  - speaker: {fileID: 11400000, guid: 6cb4028ff2cc77e478bbb362e91e66cd, type: 2}
    text: 'This was the first time I met shishi.

'
    autoProgress: 1
    autoProgressDuration: 1.25
  - speaker: {fileID: 11400000, guid: 6cb4028ff2cc77e478bbb362e91e66cd, type: 2}
    text: 'In a KFC......

'
    autoProgress: 1
    autoProgressDuration: 1.25
  - speaker: {fileID: 11400000, guid: 6cb4028ff2cc77e478bbb362e91e66cd, type: 2}
    text: Very romantic.
    autoProgress: 1
    autoProgressDuration: 1.25
  - speaker: {fileID: 11400000, guid: 6cb4028ff2cc77e478bbb362e91e66cd, type: 2}
    text: 'Oh I remember...

      Shishi and me were sitting at the table while
      they were ordering food.'
    autoProgress: 1
    autoProgressDuration: 1.25
  - speaker: {fileID: 11400000, guid: 6cb4028ff2cc77e478bbb362e91e66cd, type: 2}
    text: FOOD...
    autoProgress: 1
    autoProgressDuration: 1.25
  - speaker: {fileID: 11400000, guid: 6cb4028ff2cc77e478bbb362e91e66cd, type: 2}
    text: FRIES YUM...
    autoProgress: 1
    autoProgressDuration: 1.25
  - speaker: {fileID: 11400000, guid: 6cb4028ff2cc77e478bbb362e91e66cd, type: 2}
    text: 'I need to save shishi first, we were in the other room.

'
    autoProgress: 0
    autoProgressDuration: 1.25
